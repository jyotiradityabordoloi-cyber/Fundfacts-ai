# FundFacts AI - copy this file to .env and fill in what you need. Never commit .env.
#
# LLM (optional). Without any key the app still works for free: exact facts from the
# fact table + verified quotes from the sources.
#
# Free option: Google Gemini - create a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Paid option: Anthropic Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# auto (default) = Gemini if its key is set, else Claude if its key is set, else no LLM.
# LLM_PROVIDER=auto

# Optional overrides of config.yaml
# EMBEDDING_BACKEND=auto      # auto | sentence-transformers | onnx
# VECTOR_DB=auto              # auto | chroma | json
# TOP_K=4
# MIN_SIMILARITY=0.25
